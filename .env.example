# ===== Head node =====
POSTGRES_PASSWORD=ganti-password-db
ADMIN_TOKEN=token-admin-sementara

# ===== Dipakai head node DAN compute node =====
# Token sementara relawan (nanti diganti login GitHub)
WORKER_TOKEN=token-relawan-sementara

# ===== Compute node =====
# Worker di laptop yang sama dengan head node:
COORDINATOR_URL=http://host.docker.internal:8000
# Worker di laptop lain: isi alamat dari "./hpc.sh head-online", contoh:
# COORDINATOR_URL=https://contoh-acak.trycloudflare.com
WORKER_NAME=laptop-saya