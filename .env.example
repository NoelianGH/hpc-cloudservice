                            # ===== Head node =====
POSTGRES_PASSWORD=ganti-password-db
# Token CLI admin (./hpc.sh job, nodes, ...). Nilai contoh DITOLAK koordinator; ./hpc.sh head-up
# menggantinya dengan nilai acak. Rahasia lain (NODE_TOKEN, WEB_PROXY_SECRET) juga dibuat otomatis.
ADMIN_TOKEN=token-admin-sementara

# ===== Login dashboard admin (web /admin) =====
# Isi otomatis dengan: ./hpc.sh admin-setup  (meminta email + password, menyimpan HASH-nya saja)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Umur sesi login admin (jam)
ADMIN_SESSION_HOURS=8

# ===== Konfigurasi Verifikasi GitHub (Anti-Fake Worker) =====
# Token GitHub personal (opsional, untuk menaikkan batas rate limit API GitHub):
GITHUB_TOKEN=
# Ambang batas deteksi fake worker:
GITHUB_MIN_ACCOUNT_AGE_DAYS=30
GITHUB_MIN_PUBLIC_REPOS=2

# ===== Konfigurasi Email OTP (Head Node) =====
# Kosongkan SMTP_HOST untuk mode simulasi dev (OTP otomatis dicatat di log koordinator):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@hpc-cloud.local
SMTP_USE_TLS=true

# ===== Repo job (kode tugas) — terpisah dari repo HPC ini =====
# Repo berisi program tugas (lihat folder job-template/). Worker meng-clone repo ini
# di dalam sandbox, TEPAT pada commit SHA yang ditulis di job (bukan nama branch).
JOB_REPO_URL=
JOB_REPO_ENTRY="python3 run.py"
# Awalan URL repo yang boleh dipakai job (pisahkan dengan koma)
JOB_REPO_ALLOWLIST=https://github.com/

# ===== Publikasi hasil job ke GitHub (hanya head node yang commit) =====
# Kosongkan RESULTS_REPO_URL untuk memakai repo job itu sendiri.
# RESULTS_GIT_TOKEN: fine-grained token dengan izin "Contents: Read and write" pada repo itu saja.
# Bila token kosong, hasil tetap tersimpan di database (GET /api/jobs/<id>/result).
RESULTS_REPO_URL=
RESULTS_GIT_TOKEN=
RESULTS_BRANCH_PREFIX=results/job-

# ===== Proyek perangkat lunak yang dikerjakan relawan (repo B) =====
# Repo aplikasi (mis. website/app perusahaan). Relawan mengambil jobdesk (FIFO), bekerja di
# branch task/<id>-<judul>, dan setiap push otomatis di-build + dites terdistribusi di
# compute node relawan. Repo B wajib punya file hpc.json (lihat contoh-repo-b/).
PROJECT_REPO_URL=https://github.com/ChanceClover/hpc-cloudservice-worker
PROJECT_APP_NAME="HPC Cloud Service Worker"
PROJECT_DEFAULT_BRANCH=main
PROJECT_BRANCH_PREFIX=task/
# Opsional: fine-grained token KHUSUS repo B dengan izin Contents R/W, Commit statuses R/W,
# Administration R/W, Pull requests R/W -> branch jobdesk dibuat otomatis, clone/push relawan
# dari compute node lewat gerbang git, PR dibuka saat ajukan review dan di-merge saat admin menyetujui, hasil CI
# tampil sebagai centang/silang di GitHub. Kosong = semua itu manual.
PROJECT_GIT_TOKEN=
# Deteksi push: webhook (butuh alamat publik, isi rahasianya di sini dan di GitHub)
# dan/atau polling daftar branch tiap N detik (0 = mati). Tanpa token, batas GitHub 60 request/jam.
PROJECT_WEBHOOK_SECRET=
PROJECT_POLL_SECONDS=90
# Relawan mengambil jobdesk di website (tombol AMBIL JOBDESK = jobdesk tertua di antrean, FIFO).
# Jobdesk tetap milik relawan itu sampai selesai. JOBDESK_AUTO_ASSIGN=1 = assign otomatis lama.
JOBDESK_MAX_ACTIVE=1
JOBDESK_AUTO_ASSIGN=0

# ===== Compute node per jobdesk (relawan login dari command prompt: ssh -p 2222 jd<id>@<host>) =====
# Wajib PROJECT_GIT_TOKEN di atas (gerbang git meneruskan clone/push ke GitHub). Relawan TIDAK
# diundang jadi collaborator; push hanya bisa ke branch jobdesk-nya. Disarankan repo B private.
NODE_ACCESS=1
# Dibuat otomatis oleh ./hpc.sh head-up bila kosong
NODE_TOKEN=
# Alamat yang ditampilkan ke relawan di jaringan yang sama (isi IP LAN laptop head, mis. 192.168.1.10)
NODE_SSH_HOST=localhost
# Lima compute node: node1 di port NODE_SSH_PORT, node2..node5 di NODE2..NODE5_SSH_PORT. NODE_MAX_USERS =
# relawan aktif maksimal PER node (bawaan 1: satu node = satu relawan dengan Docker uji sendiri, 5 sekaligus).
# Bila semua penuh, AMBIL JOBDESK / MASUK LAGI KE NODE ditolak dengan pesan jelas.
NODE_SSH_PORT=2222
NODE2_SSH_PORT=2223
NODE3_SSH_PORT=2224
NODE4_SSH_PORT=2225
NODE5_SSH_PORT=2226
NODE_MAX_USERS=1
# Relawan tidak aktif sekian menit (tidak mengetik, tidak ada keluaran, tidak ada proses jalan): sesi ssh
# diputus dan node dilepas untuk relawan lain. Jobdesk, token, dan folder kerja TETAP; relawan menekan
# MASUK LAGI KE NODE di website. 0 = tidak pernah.
NODE_IDLE_MINUTES=30
# Umur maksimal token node per jobdesk (password ssh + login git, satu token). Lewat dari ini akses
# dicabut walau PR belum disetujui; admin memilih BERI AKSES NODE (token baru) atau KEMBALIKAN KE
# ANTREAN. 0 = tanpa batas (hanya dicabut saat disetujui / dibatalkan).
NODE_TOKEN_TTL_DAYS=7
# 1 = dari node relawan boleh fetch main (baca saja) untuk 'git merge origin/main'; 0 = hanya branch sendiri
NODE_READ_MAIN=1
# Batas CPU / RAM PER compute node
NODE_CPUS=1
NODE_MEMORY=2g
# Docker uji tiap node (perintah 'uji' di node): batas total per node, batas per kontainer, jumlah kontainer
NODE_TEST_CPUS=2
NODE_TEST_MEMORY=3g
NODE_TEST_CONTAINER_CPUS=1
NODE_TEST_CONTAINER_MEMORY=1g
NODE_TEST_MAX_CONTAINERS=5
# 1 = jobdesk hanya bisa diajukan review (dan di-merge) bila CI commit terakhir lulus
REQUIRE_CI_PASS=1
# CI: jumlah replika per tugas, batas waktu (detik) dan RAM (MB) per tugas build/test
CI_REPLICAS=2
CI_TIMEOUT_S=300
CI_MEMORY_MB=512

# ===== Watch + peringatan admin =====
# Peringatan tampil di dashboard admin (tab PERINGATAN) dan dikirim ke email (metode email sama
# dengan OTP di atas; tanpa metode email = hanya dicatat di log koordinator).
# Penerima (kosong = ADMIN_EMAIL). Level minimal yang di-email: info | warning | critical.
ALERT_EMAIL_TO=
ALERT_EMAIL_MIN_LEVEL=warning
# Email digabung, paling sering tiap N menit (peringatan critical: paling cepat tiap 2 menit)
ALERT_EMAIL_COOLDOWN_MIN=15
# Hasil beda dari mayoritas per worker dalam 24 jam sebelum ditandai "kemungkinan curang"
WATCH_MISMATCH_LIMIT=3

# ===== Backup database otomatis (layanan "backup", tiap awal jam) =====
# Hasil di folder backup/hourly (24 terakhir) dan backup/daily (7 hari). File .env TIDAK ikut;
# simpan terenkripsi dengan ./hpc.sh backup-env.
BACKUP_KEEP_HOURLY=24
BACKUP_KEEP_DAILY=7
# Salinan di luar folder proyek, sebaiknya folder yang disinkron ke cloud (Google Drive/OneDrive)
# agar backup selamat bila laptop rusak. Path di WSL, contoh:
# BACKUP_COPY_DIR=/mnt/c/Users/<nama>/Google Drive/hpc-backup
BACKUP_COPY_DIR=
# Zona waktu nama file backup (format POSIX; WIB-7 = UTC+7)
BACKUP_TZ=WIB-7
# Peringatan bila backup berhasil terakhir lebih tua dari N menit (0 = tidak dicek)
BACKUP_MAX_AGE_MIN=130

# ===== Login relawan =====
# Website: relawan login HANYA dengan email + password (sesi web, cookie httpOnly) selama N hari.
# Akun lama tanpa password / lupa password: "Lupa / belum punya password?" di halaman login (OTP email).
# Token worker (hpc_w_...) tidak lagi ada di website: hanya untuk mesin worker CPU (pengujian),
# diatur admin lewat "./hpc.sh worker-login" / .env repo worker.
WORKER_SESSION_DAYS=7
# Rahasia web (Next.js) <-> koordinator agar batas gagal-login memakai IP asli pengunjung.
# Dibuat otomatis oleh ./hpc.sh head-up / web-prod. Web harus dijalankan dengan .env yang sama.
WEB_PROXY_SECRET=
# 1 = kode OTP pendaftaran ikut dikirim ke browser (HANYA uji lokal tanpa email). Publik: 0.
DEV_SHOW_OTP=0
# 1 = buka dokumentasi API koordinator (/docs). Publik: 0.
API_DOCS=0
# Alamat koordinator yang ditampilkan ke relawan (COORDINATOR_URL di repo worker).
# './hpc.sh head-online' menyimpannya otomatis; isi manual hanya bila punya domain tetap.
PUBLIC_COORDINATOR_URL=

# ===== Insentif relawan (kredit, leaderboard, sertifikat) =====
CERT_MIN_CREDITS=50
CERT_MAX_REJECT_PCT=10

# ===== Dipakai head node DAN compute node =====
# Token worker relawan. Bisa menggunakan token sementara atau token hasil
# autentikasi CLI ("./hpc.sh worker-login" atau "python worker_auth_cli.py")
WORKER_TOKEN=token-relawan-sementara

# ===== Compute node =====
# Worker di laptop yang sama dengan head node:
COORDINATOR_URL=http://host.docker.internal:8000
# Worker di laptop lain: isi alamat dari "./hpc.sh head-online", contoh:
# COORDINATOR_URL=https://contoh-acak.trycloudflare.com
WORKER_NAME=laptop-saya
# Batas sandbox worker (CPU & RAM), juga dilaporkan ke koordinator untuk pencocokan resource job
WORKER_CPUS=1
WORKER_MEMORY_MB=512
# WORKER_ID dan WORKER_TOKEN diisi otomatis oleh "./hpc.sh worker-login"
# (atau "python worker_auth_cli.py"). Bisa juga diisi manual setelah login:
WORKER_ID=
