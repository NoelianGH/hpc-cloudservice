# ===== Head node =====
POSTGRES_PASSWORD=ganti-password-db
ADMIN_TOKEN=token-admin-sementara

# ===== Konfigurasi Verifikasi GitHub (Anti-Fake Worker) =====
# Token GitHub personal (opsional, untuk menaikkan batas rate limit API GitHub):
GITHUB_TOKEN=
# Ambang batas deteksi fake worker:
GITHUB_MIN_ACCOUNT_AGE_DAYS=30
GITHUB_MIN_PUBLIC_REPOS=2

# ===== Konfigurasi Email OTP (Head Node) =====
# Kosongkan SMTP_HOST untuk mode simulasi dev (OTP otomatis dicatat di log koordinator):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@hpc-cloud.local
SMTP_USE_TLS=true

# ===== Dipakai head node DAN compute node =====
# Token worker relawan. Bisa menggunakan token sementara atau token hasil
# autentikasi CLI ("./hpc.sh worker-login" atau "python worker_auth_cli.py")
WORKER_TOKEN=token-relawan-sementara

# ===== Compute node =====
# Worker di laptop yang sama dengan head node:
COORDINATOR_URL=http://host.docker.internal:8000
# Worker di laptop lain: isi alamat dari "./hpc.sh head-online", contoh:
# COORDINATOR_URL=https://contoh-acak.trycloudflare.com
WORKER_NAME=laptop-saya
# WORKER_ID dan WORKER_TOKEN diisi otomatis oleh "./hpc.sh worker-login"
# (atau "python worker_auth_cli.py"). Bisa juga diisi manual setelah login:
WORKER_ID=
